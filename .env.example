# Copy to .env in the project root. npm run cloud loads it automatically.
# Never commit .env, real credentials, data/, or mail preview files.
PORT=4174
HOST=127.0.0.1
ALLOW_REGISTRATION=true

# Public origin, without a path. HTTPS required except localhost.
# For local Google OAuth testing use http://127.0.0.1:4174
# PUBLIC_URL=https://studio.example.com
# ATELIER_DATA_DIR=/var/lib/atelier

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Required for any mail mode; keep stable across restarts. At least 32 random characters.
AUTH_SECRET=

# Gmail without your own domain: set MAIL_MODE=gmail and fill these two values.
# Enable Google 2-Step Verification, then create an app password for Atelier.
# Use the 16-character app password, NEVER your normal Gmail password.
# MAIL_MODE=gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=

# WEB.DE mailbox, even when its address is also used for a Google account:
# MAIL_MODE=webde
WEBDE_USER=
WEBDE_APP_PASSWORD=
# Create this app password at WEB.DE, NOT at Google.

# Real transactional email delivery through Resend. Use your verified sending domain.
# The server never exposes these keys to browser code.
RESEND_API_KEY=
MAIL_FROM=

# Google Cloud OAuth client type: Web application.
# Authorized redirect URI: YOUR_PUBLIC_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development only; never enable on a public host.
# MAIL_MODE=preview
# MAIL_PREVIEW_DIR=./data/mail-preview
# ALLOW_UNVERIFIED_REGISTRATION=false
